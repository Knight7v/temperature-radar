# 复制为 .env.local 并填值(.env*.local 已被 .gitignore 忽略)。
# Vercel 上用 `vercel env add <NAME>` 配置同名变量。

# === P0 新增 ===
# Neon 数据库 —— `vercel integration add neon` 后自动注入;本地 `vercel env pull` 获取
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# 鉴权密钥(≥16 字符,随机生成:openssl rand -base64 32)
JWT_SECRET=

# === 沿用既有 ===
QWEATHER_API_KEY=
WECOM_BOT_WEBHOOK=
CRON_SECRET=

# === 库存 / 补货 ===
# 库存机器人 Webhook 加密密钥(32 字节随机数 Base64: openssl rand -base64 32)
INVENTORY_WEBHOOK_ENCRYPTION_KEY=
# 库存机器人(补货分析)推送企微的总开关:off=暂停(默认),on=开启
INVENTORY_PUSH_ENABLED=off

# === 种子(可选,首次 npm run db:seed 用) ===
SEED_TENANT_NAME=默认租户
SEED_TENANT_SLUG=default
SEED_ADMIN_IDENTIFIER=admin
SEED_ADMIN_PASSWORD=

# === AI 质检(DeepSeek) ===
# 在 https://platform.deepseek.com 创建 API Key 后填入;留空则 AI 质检功能自动隐藏
DEEPSEEK_API_KEY=
# 可选:默认 https://api.deepseek.com ;换成代理地址时改这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选:deepseek-chat(默认,便宜快) 或 deepseek-reasoner(更准,更贵)
DEEPSEEK_MODEL=deepseek-chat
# 可选:单次请求超时毫秒,默认 90000
DEEPSEEK_TIMEOUT_MS=90000

# === 视觉设计 AI 作图(背景生成) ===
# 服务商:硅基流动 https://cloud.siliconflow.cn —— 注册后在「API 密钥」页创建,国内直连、按张计费
# 留空则 AI 生成背景不可用,但内置场景库(assets/design/scenes)仍然可以正常出图
DESIGN_IMAGE_API_KEY=
# 可选:默认 https://api.siliconflow.cn/v1 ;换任何 OpenAI 兼容网关只改这里
DESIGN_IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# 可选:Kwai-Kolors/Kolors(免费) Tongyi-MAI/Z-Image-Turbo(约0.1元) Qwen/Qwen-Image(约0.3元)
DESIGN_IMAGE_MODEL=Kwai-Kolors/Kolors
# 可选:siliconflow(默认,用 image_size/batch_size) 或 openai(用 size/n)
DESIGN_IMAGE_PROTOCOL=siliconflow
# 可选:单张生成超时毫秒,默认 120000
DESIGN_IMAGE_TIMEOUT_MS=120000
